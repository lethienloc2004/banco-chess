skinparam ActorBackgroundColor #F6EEE3
skinparam ParticipantBackgroundColor #F6EEE3
skinparam ParticipantBorderColor #8B5E34
skinparam SequenceLifeLineBorderColor #B79B82
skinparam SequenceGroupBorderColor #B79B82
skinparam SequenceGroupBackgroundColor #FBF8F3
skinparam ActivityBackgroundColor #F6EEE3
skinparam ActivityBorderColor #8B5E34
