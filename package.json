{
  "name": "ban-co",
  "version": "0.1.0",
  "description": "Chơi cờ vua, cờ tướng và cờ tướng úp trên trình duyệt: máy chơi cùng, chơi online, ghép ngẫu nhiên, xếp hạng.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node scripts/local.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "dev:server": "wrangler d1 migrations apply DB --local && wrangler dev --port 8787 --var DEV:1",
    "build": "tsc --noEmit && tsc -p server --noEmit && vite build",
    "test": "vitest run",
    "test:server": "node tests/e2e/server.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy && wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lethienloc2004/banco-chess"
  },
  "homepage": "https://github.com/lethienloc2004/banco-chess#readme",
  "bugs": {
    "url": "https://github.com/lethienloc2004/banco-chess/issues"
  },
  "keywords": [
    "chess",
    "xiangqi",
    "chinese-chess",
    "jieqi",
    "board-game",
    "cloudflare-workers",
    "typescript",
    "vietnamese"
  ]
}
